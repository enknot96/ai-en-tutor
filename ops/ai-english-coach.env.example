# Copy to /etc/ai-english-coach.env on the server (owner root:coach, mode 640).
# Never commit the real file. Values below are placeholders.

# Login password for the single user
APP_PASSWORD=change-me

# Signs the session cookie. At least 32 characters (the app rejects shorter values)
AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

OPENAI_API_KEY=sk-placeholder
GUARDIAN_API_KEY=placeholder
